{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "fs:allow-app-read-recursive",
    "fs:allow-app-write-recursive",
    "shell:allow-open"
  ]
}
